# Numeric records use immutable bindings and the real worker/native agent path.

record(ai, "$(P)MatrixIntegerAi") {
    field(DESC, "Numeric ai conversion boundary")
    field(DTYP, "snmp3")
    field(INP, "@binding=MatrixIntegerRead deadline_ms=5000")
}

record(longin, "$(P)MatrixIntegerLongin") {
    field(DESC, "Numeric longin conversion boundary")
    field(DTYP, "snmp3")
    field(INP, "@binding=MatrixIntegerRead deadline_ms=5000")
}

