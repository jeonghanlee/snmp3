# State of one endpoint of the snmp3 configuration, read from the IOC process; no request goes to a unit.
# P        : PV prefix
# ENDPOINT : id of the endpoint in the snmp3 configuration
# SCAN     : scan of the records (default "1 second"): a period, after which a change of a state is visible at
#            the latest, or "I/O Intr", with which the records process when a state changes
record(mbbi, "$(P)PeerState") {
    field(DESC, "Engine ID state of the endpoint")
    field(DTYP, "snmp3 state")
    field(INP,  "@peer=$(ENDPOINT)")
    field(SCAN, "$(SCAN=1 second)")
    field(PINI, "YES")
    field(ZRVL, "0")
    field(ZRST, "normal")
    field(ONVL, "1")
    field(ONST, "changed")
    field(ONSV, "MAJOR")
    field(TWVL, "2")
    field(TWST, "unverified")
    field(TWSV, "MAJOR")
}
# Largest number of values of one request after a rejection of the unit. 0: no rejection has lowered it, or the
# worker of the address has ended or was restarted since.
record(longin, "$(P)BatchLimit") {
    field(DESC, "Values per request after a rejection")
    field(DTYP, "snmp3 state")
    field(INP,  "@batchLimit=$(ENDPOINT)")
    field(SCAN, "$(SCAN=1 second)")
    field(PINI, "YES")
}
record(longin, "$(P)BatchSplits") {
    field(DESC, "Reductions of the request size")
    field(DTYP, "snmp3 state")
    field(INP,  "@batchSplits=$(ENDPOINT)")
    field(SCAN, "$(SCAN=1 second)")
    field(PINI, "YES")
}
# Requests handed to the worker as one GETBULK for consecutive instances of one column of the address, since the IOC
# started. A request that the worker then does not send (an SNMPv3 unit that does not answer its engine ID request) is
# counted too.
record(longin, "$(P)Bulks") {
    field(DESC, "Requests handed over as GETBULK")
    field(DTYP, "snmp3 state")
    field(INP,  "@bulks=$(ENDPOINT)")
    field(SCAN, "$(SCAN=1 second)")
    field(PINI, "YES")
}
